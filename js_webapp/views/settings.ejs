<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>Settings</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/main.css">
</head>
<body class="container">
<h2 class="mb-3">Settings</h2>
<form method="post" action="/settings" class="mb-3">
  <label class="form-label">RPC Provider</label>
  <input class="form-control mb-2" type="text" name="provider" value="<%= user.provider %>">
  <label class="form-label">Private Key</label>
  <input class="form-control mb-2" type="text" name="privateKey" value="<%= user.privateKey %>">
  <button class="btn btn-primary" type="submit">Save</button>
</form>
<a href="/">Home</a>
</body>
</html>
