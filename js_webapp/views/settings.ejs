<!doctype html>
<html>
<head>
  <title>Settings</title>
  <link rel="stylesheet" href="/main.css">
</head>
<body>
  <h2>Settings</h2>
  <form method="post" action="/settings">
    <label>RPC Provider</label><br>
    <input type="text" name="provider" value="<%= user.provider %>"><br>
    <label>Private Key</label><br>
    <input type="text" name="privateKey" value="<%= user.privateKey %>"><br>
    <button type="submit">Save</button>
  </form>
  <a href="/">Home</a>
</body>
</html>
